import json
import os
import urllib.request
import re
from datetime import datetime, timedelta

# Import boto3 dan inisialisasi EC2 dihapus karena sudah di-handle oleh Lambda Control

def lambda_handler(event, context):
    bot_token = os.environ['BOT_TOKEN']
    chat_id = os.environ['CHAT_ID']
    # THREAD_ID ini diisi dengan ID dari Topik "Alarm HOKI TDM"
    thread_id = os.environ.get('THREAD_ID') 
    
    url = f"https://api.telegram.org/bot{bot_token}/sendMessage"

    try:
        alarm_data = event.get('alarmData', {})
        # Tambahan replace untuk mencegah Error 400 karena format Markdown Telegram
        alarm_name = alarm_data.get('alarmName', 'Unknown Alarm').replace('_', '\\_')
        
        state_data = alarm_data.get('state', {})
        new_state = state_data.get('value', 'UNKNOWN')
        raw_reason = state_data.get('reason', 'Tidak ada detail')
        
        # --- BLOK KONVERSI WAKTU UTC KE WIB ---
        def convert_to_wib(match):
            utc_time_str = match.group(1)
            try:
                utc_time = datetime.strptime(utc_time_str, '%d/%m/%y %H:%M:%S')
                wib_time = utc_time + timedelta(hours=7)
                return wib_time.strftime('%d/%m/%y %H:%M:%S WIB')
            except ValueError:
                return utc_time_str

        reason = re.sub(r'(\d{2}/\d{2}/\d{2}\s\d{2}:\d{2}:\d{2})', convert_to_wib, raw_reason)
        # --------------------------------------

        region = event.get('region', 'ap-southeast-1')
        icon = "🚨" if new_state == "ALARM" else ("✅" if new_state == "OK" else "⚠️")

        text = f"{icon} *TDM CloudWatch Alert*\n\n"
        text += f"*Alarm:* {alarm_name}\n"
        text += f"*Status:* {new_state}\n"
        text += f"*Region:* {region}\n"
        text += f"*Detail:* {reason}"

        payload = {
            "chat_id": chat_id,
            "text": text,
            "parse_mode": "Markdown"
        }
        
        if thread_id:
            payload["message_thread_id"] = int(thread_id)

        # ==============================================================
        # BLOK TOMBOL CHATOPS TELAH DIHAPUS (Dipindah ke Lambda ke-2)
        # ==============================================================

        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode('utf-8'),
            headers={'Content-Type': 'application/json'}
        )

        response = urllib.request.urlopen(req)
        return {
            'statusCode': response.getcode(),
            'body': 'Alert berhasil dikirim ke grup Telegram'
        }
    except Exception as e:
        print(f"Error memproses event CloudWatch: {str(e)}")
        print("Raw event data:", json.dumps(event))
        return {
            'statusCode': 500,
            'body': 'Gagal mengirim pesan'
        }


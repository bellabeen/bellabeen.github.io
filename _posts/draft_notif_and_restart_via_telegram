import json
import boto3
import os
import urllib.request

ec2 = boto3.client('ec2', region_name='ap-southeast-1')
ssm = boto3.client('ssm', region_name='ap-southeast-1')

# Konfigurasi Nama Dokumen SSM Anda
SSM_DOCUMENT_NAME = 'TDM-Pull-Restart-Hoki'
SSM_UPGRADE_DOCUMENT = 'TDM-Odoo-Upgrade-Module'

def get_dynamic_instance_id(server_name):
    """Mencari Instance ID berdasarkan tag Name"""
    response = ec2.describe_instances(
        Filters=[
            {'Name': 'tag:Name', 'Values': [server_name]},
            {'Name': 'instance-state-name', 'Values': ['pending', 'running', 'stopping', 'stopped']}
        ]
    )
    for reservation in response['Reservations']:
        for instance in reservation['Instances']:
            return instance['InstanceId']
    return None

def lambda_handler(event, context):
    try:
        body = json.loads(event.get('body', '{}'))
        bot_token = os.environ['BOT_TOKEN']
        url_msg = f"https://api.telegram.org/bot{bot_token}/sendMessage"
        url_ans = f"https://api.telegram.org/bot{bot_token}/answerCallbackQuery"
        
        # ==============================================================
        # 1. PENANGANAN TEKS PERINTAH (/menu, /deploy, /upgrade)
        # ==============================================================
        if 'message' in body and 'text' in body['message']:
            message = body['message']
            chat_id = str(message['chat']['id'])
            text = str(message['text']).strip()
            thread_id = message.get('message_thread_id')
            
            # Validasi Chat ID (Grup)
            if chat_id != os.environ['ALLOWED_CHAT_ID']: 
                return {'statusCode': 403, 'body': 'Ditolak'}
            
            # Validasi Thread ID (Topik Khusus Control)
            allowed_thread = os.environ.get('ALLOWED_THREAD_ID')
            if allowed_thread and str(thread_id) != allowed_thread:
                # Mengabaikan pesan yang dikirim di luar topik "Control Hoki TDM"
                return {'statusCode': 200, 'body': 'Beda Topik'}
                
            # --- FITUR: Menu Rolling Deployment ---
            if text.startswith('/menu') or text.startswith('/deploy'):
                cron_id = get_dynamic_instance_id('TunasHoki-Cron')
                
                dynamic_keyboard = [
                    [{"text": "🚀 Deploy Cron", "callback_data": "deploy_cron"}],
                    [{"text": "🚀 Deploy WebApp", "callback_data": "deploy_webapp"}],
                    [{"text": "🚀 Deploy API", "callback_data": "deploy_api"}]
                ]
                
                status_text = ""
                if cron_id:
                    try:
                        resp = ec2.describe_instances(InstanceIds=[cron_id])
                        server_state = resp['Reservations'][0]['Instances'][0]['State']['Name']
                        
                        if server_state == 'stopped':
                            dynamic_keyboard.append([{"text": "▶️ Start Cron", "callback_data": "start_cron"}])
                            status_icon = "🛑"
                        elif server_state == 'running':
                            dynamic_keyboard.append([{"text": "🔄 Restart Cron", "callback_data": "restart_cron"}])
                            dynamic_keyboard.append([{"text": "🛑 Stop Cron", "callback_data": "stop_cron"}])
                            status_icon = "✅"
                        else:
                            dynamic_keyboard.append([{"text": f"⏳ Sedang {server_state}", "callback_data": "ignore"}])
                            status_icon = "⏳"
                            
                        status_text = f"\nStatus Server Cron: {status_icon} `{server_state}`"
                    except Exception:
                        pass

                payload_msg = {
                    "chat_id": chat_id,
                    "text": f"🛠️ *TDM Command Center*{status_text}\nSilakan pilih target server:",
                    "parse_mode": "Markdown",
                    "reply_markup": {"inline_keyboard": dynamic_keyboard}
                }
                if thread_id: payload_msg["message_thread_id"] = thread_id
                urllib.request.urlopen(urllib.request.Request(url_msg, data=json.dumps(payload_msg).encode('utf-8'), headers={'Content-Type': 'application/json'}))
            
            # --- FITUR BARU: Odoo Module Upgrade ---
            elif text.startswith('/upgrade '):
                module_name = text.split('/upgrade ', 1)[1].strip()
                
                try:
                    response = ssm.send_command(
                        Targets=[{'Key': 'tag:Name', 'Values': ['TunasHoki-Cron']}],
                        DocumentName=SSM_UPGRADE_DOCUMENT, 
                        Parameters={'ModuleName': [module_name]},
                        Comment=f'Upgrade module {module_name} via Telegram'
                    )
                    
                    msg = (f"📦 *Otomatisasi Upgrade Dimulai!*\n"
                           f"Modul: `{module_name}`\n"
                           f"Target: `TunasHoki-Cron`\n"
                           f"Command ID: `{response['Command']['CommandId']}`\n\n"
                           f"_Silakan tunggu status Success di AWS. Jika sudah selesai, panggil /menu untuk deploy WebApp & API._")
                    
                except Exception as e:
                    msg = f"❌ *Gagal eksekusi upgrade:*\n`{str(e)}`"
                
                payload_msg = {"chat_id": chat_id, "text": msg, "parse_mode": "Markdown"}
                if thread_id: payload_msg["message_thread_id"] = thread_id
                urllib.request.urlopen(urllib.request.Request(url_msg, data=json.dumps(payload_msg).encode('utf-8'), headers={'Content-Type': 'application/json'}))
                
            return {'statusCode': 200, 'body': 'OK'}

        # ==============================================================
        # 2. PENANGANAN KLIK TOMBOL (CALLBACK QUERY)
        # ==============================================================
        elif 'callback_query' in body:
            callback = body['callback_query']
            chat_id = str(callback['message']['chat']['id'])
            data = callback['data']
            callback_id = callback['id']
            thread_id = callback['message'].get('message_thread_id')
            
            # Validasi Chat ID (Grup)
            if chat_id != os.environ['ALLOWED_CHAT_ID']: 
                return {'statusCode': 403, 'body': 'Ditolak'}
            
            # Validasi Thread ID (Topik Khusus Control)
            allowed_thread = os.environ.get('ALLOWED_THREAD_ID')
            if allowed_thread and str(thread_id) != allowed_thread:
                return {'statusCode': 200, 'body': 'Beda Topik'}
            
            def send_reply(text_msg, popup_msg):
                payload_msg = {"chat_id": chat_id, "text": text_msg, "parse_mode": "Markdown"}
                if thread_id: payload_msg["message_thread_id"] = thread_id
                try: urllib.request.urlopen(urllib.request.Request(url_msg, data=json.dumps(payload_msg).encode('utf-8'), headers={'Content-Type': 'application/json'}))
                except Exception: pass
                try: urllib.request.urlopen(urllib.request.Request(url_ans, data=json.dumps({"callback_query_id": callback_id, "text": popup_msg}).encode('utf-8'), headers={'Content-Type': 'application/json'}))
                except Exception: pass

            deploy_targets = {
                "deploy_cron": "TunasHoki-Cron",
                "deploy_webapp": "TDM-TunasHoki-WebApp",
                "deploy_api": "TDM-TunasHoki-API"
            }

            if data in deploy_targets:
                target_tag = deploy_targets[data]
                try:
                    response = ssm.send_command(
                        Targets=[{'Key': 'tag:Name', 'Values': [target_tag]}],
                        DocumentName=SSM_DOCUMENT_NAME,
                        Comment=f'Telegram ChatOps Deploy to {target_tag}'
                    )
                    send_reply(f"🚀 *Deployment Dimulai!*\nTarget: `{target_tag}`\nSSM Command ID: `{response['Command']['CommandId']}`", f"Deploying {target_tag}...")
                except Exception as e:
                    send_reply(f"❌ *Gagal Deploy ke {target_tag}:*\n`{str(e)}`", "Gagal SSM!")
                return {'statusCode': 200, 'body': 'OK'}

            if data in ["start_cron", "stop_cron", "restart_cron"]:
                active_instance_id = get_dynamic_instance_id("TunasHoki-Cron")
                if not active_instance_id:
                    send_reply("❌ *Gagal:* Server Cron tidak ditemukan!", "Not Found")
                    return {'statusCode': 200, 'body': 'OK'}

                try:
                    resp = ec2.describe_instances(InstanceIds=[active_instance_id])
                    current_state = resp['Reservations'][0]['Instances'][0]['State']['Name']

                    if data == "start_cron":
                        if current_state == 'running': send_reply("ℹ️ Cron sudah HIDUP.", "Sudah hidup!")
                        else:
                            ec2.start_instances(InstanceIds=[active_instance_id])
                            send_reply(f"▶️ Menghidupkan Cron\nID: `{active_instance_id}`", "Starting...")
                            
                    elif data == "stop_cron":
                        if current_state == 'stopped': send_reply("ℹ️ Cron sudah MATI.", "Sudah mati!")
                        else:
                            ec2.stop_instances(InstanceIds=[active_instance_id])
                            send_reply(f"🛑 Mematikan Cron\nID: `{active_instance_id}`", "Stopping...")
                            
                    elif data == "restart_cron":
                        if current_state != 'running': send_reply("❌ Cron harus HIDUP untuk di-Restart.", "Gagal!")
                        else:
                            ec2.reboot_instances(InstanceIds=[active_instance_id])
                            send_reply(f"✅ Me-restart Cron\nID: `{active_instance_id}`", "Restarting...")

                except Exception as e:
                    if 'IncorrectInstanceState' in str(e): send_reply("⏳ Server masih transisi. Tunggu 1 menit.", "Transisi!")
                    else: send_reply(f"❌ *Error EC2:*\n`{str(e)}`", "Error!")

        return {'statusCode': 200, 'body': 'OK'}
    except Exception as e:
        print(f"Error: {e}")
        return {'statusCode': 500, 'body': 'Error'}



# Multi Pull System
#!/bin/bash
exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1

# --- FIX HEADLESS ENVIRONMENT ---
export HOME=/root

echo "Memulai otomatisasi Git Pull Odoo via SSH Deploy Key..."

AWS_REGION="ap-southeast-1"
# Set direktori SSH untuk user ubuntu dan root
UBUNTU_SSH_DIR="/home/ubuntu/.ssh"
GITHUB_KEY_PATH="$UBUNTU_SSH_DIR/id_rsa_github"

ROOT_SSH_DIR="/root/.ssh"
ROOT_KEY_PATH="$ROOT_SSH_DIR/id_rsa_github"

# ==========================================
# KONFIGURASI APLIKASI
# Format: "DIREKTORI;BRANCH;REPO_URL;NAMA_SERVICE"
# ==========================================
APPS=(
    "/opt/tmp/custom_addons/teto-staging-it;teto;git@github.com:tunasgroup/tdm_teto.git;teds2-staging-it.service"
)

# 1. Menyiapkan Direktori SSH untuk Ubuntu
mkdir -p "$UBUNTU_SSH_DIR"

echo "Mengambil SSH Deploy Key dari Parameter Store..."
aws ssm get-parameter \
    --name "/odoo/github_deploy_key" \
    --with-decryption \
    --query "Parameter.Value" \
    --output text \
    --region $AWS_REGION > "$GITHUB_KEY_PATH"

if [ ! -s "$GITHUB_KEY_PATH" ]; then
    echo "ERROR: Gagal mengambil SSH Key dari SSM. Proses dibatalkan."
    exit 1
fi

# Mengatur permission file kunci SSH Ubuntu
chmod 600 "$GITHUB_KEY_PATH"

# Membuat konfigurasi SSH agar otomatis menggunakan kunci ini untuk GitHub (Ubuntu)
cat <<EOF > "$UBUNTU_SSH_DIR/config"
Host github.com
    HostName github.com
    User git
    IdentityFile $GITHUB_KEY_PATH
    StrictHostKeyChecking no
EOF
chmod 600 "$UBUNTU_SSH_DIR/config"

# Rapikan kepemilikan agar user ubuntu bisa menggunakannya saat login manual
chown -R ubuntu:ubuntu "$UBUNTU_SSH_DIR"


# 1b. Menyiapkan Direktori SSH untuk Root
echo "Mengonfigurasi SSH Deploy Key untuk user root..."
mkdir -p "$ROOT_SSH_DIR"
cp "$GITHUB_KEY_PATH" "$ROOT_KEY_PATH"
chmod 600 "$ROOT_KEY_PATH"

cat <<EOF > "$ROOT_SSH_DIR/config"
Host github.com
    HostName github.com
    User git
    IdentityFile $ROOT_KEY_PATH
    StrictHostKeyChecking no
EOF
chmod 600 "$ROOT_SSH_DIR/config"


# 1c. Mendaftarkan Folder EFS ke daftar Aman
echo "Mendaftarkan folder EFS ke safe directory untuk root dan ubuntu..."
git config --global --add safe.directory /opt/tdm_teds2_code/odoo/custom-addons/teto-staging-it
sudo -u ubuntu git config --global --add safe.directory /opt/tdm_teds2_code/odoo/custom-addons/teto-staging-it


# 2. Looping Eksekusi Aplikasi
for app in "${APPS[@]}"; do
    IFS=";" read -r DIR BRANCH REPO SERVICE <<< "$app"
    
    echo "---------------------------------------------------"
    echo "Memproses Service : $SERVICE"
    echo "Target Direktori  : $DIR"
    
    if [ ! -d "$DIR" ]; then
        echo "WARNING: Direktori $DIR tidak ditemukan! Melewati eksekusi service ini..."
        continue
    fi

    cd "$DIR"

    # Ubah kepemilikan direktori menjadi ubuntu SEBELUM perintah git
    echo "Menyesuaikan hak akses direktori untuk user ubuntu..."
    chown -R ubuntu:ubuntu "$DIR"
    
    # Daftarkan direktori agar aman dieksekusi git (untuk user ubuntu juga)
    git config --global --add safe.directory "$DIR"
    sudo -u ubuntu git config --global --add safe.directory "$DIR"
    
    # Pastikan URL remote origin diset ke SSH agar pull manual tidak minta token
    sudo -u ubuntu git remote set-url origin "$REPO"
    
    echo "Menarik kode terbaru dari branch $BRANCH..."
    # Eksekusi git pull sebagai user ubuntu memanfaatkan config SSH yang sudah dibuat
    sudo -u ubuntu git pull origin "$BRANCH"
    
    echo "Me-restart Service $SERVICE..."
    systemctl restart "$SERVICE"
    
    echo "[SUKSES] $SERVICE selesai diproses!"
done

echo "---------------------------------------------------"
echo "Proses otomatisasi User Data selesai sepenuhnya!"


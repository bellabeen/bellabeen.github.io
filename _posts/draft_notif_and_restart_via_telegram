schemaVersion: '2.2'
description: 'Otomatisasi Pull, Update Aurora DB, dan Auto-Monitor Odoo'
parameters:
  ModuleName:
    type: String
    description: "Nama module teknis yang akan diupgrade"
mainSteps:
- action: aws:runShellScript
  name: upgradeAndMonitor
  inputs:
    runCommand:
    - "#!/bin/bash"
    - "sudo su - ubuntu << 'EOF'"
    - "cd /opt/tdm_hoki_code/odoo/custom-addons/addons-test"
    - "export AWS_SHARED_CREDENTIALS_FILE=/dev/null"
    - "export AWS_ACCESS_KEY_ID="
    - "export AWS_SECRET_ACCESS_KEY="
    - "# 1. Pull Git dengan SSH Key Ephemeral"
    - "aws ssm get-parameter --region ap-southeast-1 --name \"/tdm/github_tdm_hoki\" --with-decryption --query \"Parameter.Value\" --output text > /tmp/ephemeral_deploy_key"
    - "chmod 600 /tmp/ephemeral_deploy_key"
    - "export GIT_SSH_COMMAND=\"ssh -i /tmp/ephemeral_deploy_key -o StrictHostKeyChecking=no\""
    - "sudo -E git pull git@github.com:tunasgroup/tdm_hoki_addons.git master"
    - "rm -f /tmp/ephemeral_deploy_key"
    - "sudo systemctl restart odoo10.service"
    - "EOF"
    - ""
    - "# 2. Konfigurasi Aurora PostgreSQL (Silakan ubah Host dan DB Name)"
    - "DB_HOST='tdm-tunashoki.cswqm0yywcis.ap-southeast-1.rds.amazonaws.com'"
    - "DB_NAME='hoki'"
    - ""
    - "# Ambil User dan Password dari brankas AWS secara on-the-fly"
    - "export DB_USER=$(aws ssm get-parameter --region ap-southeast-1 --name \"/tdm/hoki_db_user\" --with-decryption --query \"Parameter.Value\" --output text)"
    - "export PGPASSWORD=$(aws ssm get-parameter --region ap-southeast-1 --name \"/tdm/hoki_db_password\" --with-decryption --query \"Parameter.Value\" --output text)"
    - ""
    - "# 3. Eksekusi Query Update ke Aurora"
    - "psql -h $DB_HOST -U $DB_USER -d $DB_NAME -c \"UPDATE ir_module_module SET state = 'to upgrade' WHERE name = '{{ModuleName}}';\""
    - ""
    - "# 4. Restart kedua untuk memicu instalasi/upgrade Odoo"
    - "sudo systemctl restart odoo10.service"
    - ""
    - "# 5. Smart Monitoring: Looping terus menerus sampai state bersih di Aurora"
    - "echo 'Memantau Aurora, menunggu Odoo menyelesaikan upgrade module: {{ModuleName}}...'"
    - "while [ $(psql -h $DB_HOST -U $DB_USER -d $DB_NAME -t -A -c \"SELECT count(*) FROM ir_module_module WHERE state LIKE 'to up%';\") -gt 0 ]; do"
    - "  sleep 5"
    - "done"
    - "echo 'Upgrade selesai! Semua state sudah bersih.'"
    - ""
    - "# Bersihkan memori kredensial"
    - "unset PGPASSWORD"
    - "unset DB_USER"

